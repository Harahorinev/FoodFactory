&НаКлиенте
Процедура ПроверитьНормализациюМассива(Команда)
	ИсходныеАртикулы = Новый Массив;
	ИсходныеАртикулы.Добавить(" flour-001 ");
	ИсходныеАртикулы.Добавить("");
	ИсходныеАртикулы.Добавить(Неопределено);
	ИсходныеАртикулы.Добавить("milk-007");
	ИсходныеАртикулы.Добавить("FLOUR-001");
	Сообщить("Исходных до: " +  ИсходныеАртикулы.Количество());
	Результат = УтилитыFoodFactory.НормализоватьАртикулы(ИсходныеАртикулы);
	Сообщить("Исходных после: " + ИсходныеАртикулы.Количество());
	Сообщить("Результат: " + Результат.Количество());
	
	Для каждого Элемент Из Результат Цикл
		Сообщить(Элемент);
	КонецЦикла;
	
	Попытка
		УтилитыFoodFactory.НормализоватьАртикулы("2");
		Сообщить("ОШИБКА ТЕСТА: строка была принята как массив");
	Исключение
		Сообщить("Ожидаемая ошибка: " + ОписаниеОшибки());
	КонецПопытки;  
	
	Попытка
		ВременныйМассив = Новый Массив();
		ВременныйМассив.Добавить(42);
		УтилитыFoodFactory.НормализоватьАртикулы(ВременныйМассив);
		Сообщить("ОШИБКА ТЕСТА: массив был принят как массив чисел");                        
	Исключение
		Сообщить("Ожидаемая ошибка: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАнализАртикулов(Команда)
	ИсходныеАртикулы = Новый Массив;
	ИсходныеАртикулы.Добавить(" flour-001 ");
	ИсходныеАртикулы.Добавить("milk-007");
	ИсходныеАртикулы.Добавить("FLOUR-001");
	ИсходныеАртикулы.Добавить("");
	ИсходныеАртикулы.Добавить("milk-007");
	ИсходныеАртикулы.Добавить("salt-001");
	ИсходныеАртикулы.Добавить("FLOUR-001");
	ИсходныеАртикулы.Добавить(" flour-001 ");
	
	РезультатАнализа = УтилитыFoodFactory.ПроанализироватьАртикулы(ИсходныеАртикулы);
	Сообщить("Нормализованных: " + РезультатАнализа.НормализованныеАртикулы.Количество());
	Сообщить("Дублей: " + РезультатАнализа.Дубли.Количество());
	
	Для Каждого Элемент Из РезультатАнализа.Дубли Цикл
		Сообщить(Элемент);
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ТестПроверкиАртикула(Команда)
	Результат = ПроверкиFoodFactory.ПроверитьАртикул(" flour-001 ");
	
	Если Результат.Корректен <> Истина Тогда
		ВызватьИсключение "Ожидалось, что артикул корректен";
	КонецЕсли;
	Если Результат.Сообщение <> "" Тогда		ВызватьИсключение "Ошибка: " + Результат.Сообщение;	КонецЕсли;	Если Результат.НормализованныйАртикул <> "FLOUR-001" Тогда		ВызватьИсключение "Ожидалось FLOUR-001";
	КонецЕсли;
	
	Результат = ПроверкиFoodFactory.ПроверитьАртикул("");
	
	Если Результат.Корректен = Истина Тогда
		ВызватьИсключение "Полученно корректное значение";
	КонецЕсли;
	Если Результат.Сообщение <> "Артикул не должен быть пустым" Тогда
		ВызватьИсключение "Поле Сообщение: " + Результат.Сообщение;
	КонецЕсли;
	Если Результат.НормализованныйАртикул <> "" Тогда
		ВызватьИсключение "Поле НормализованныйАртикул: " + Результат.НормализованныйАртикул;
	КонецЕсли;
	
	Результат = ПроверкиFoodFactory.ПроверитьАртикул("   ");
	
	Если Результат.Корректен = Истина Тогда
		ВызватьИсключение "Полученно корректное значение для пробелов";
	КонецЕсли;
	Если Результат.Сообщение <> "Артикул не должен быть пустым" Тогда
		ВызватьИсключение "Поле Сообщение для пробелов: " + Результат.Сообщение;
	КонецЕсли;
	Если Результат.НормализованныйАртикул <> "" Тогда
		ВызватьИсключение "Поле НормализованныйАртикул для пробелов: " + Результат.НормализованныйАртикул;
	КонецЕсли;
	
	Результат = ПроверкиFoodFactory.ПроверитьАртикул("1234567890123456789012345678901");
	
	Если Результат.Корректен <> Ложь Тогда
		ВызватьИсключение "Полученно корректное значение для более 31 символа";
	КонецЕсли;
	Если Результат.Сообщение <> "Артикул не должен быть длиннее 30 символов" Тогда
		ВызватьИсключение "Поле Сообщение для длинной строки: " + Результат.Сообщение;
	КонецЕсли;
	Если Результат.НормализованныйАртикул <> "1234567890123456789012345678901" Тогда
		ВызватьИсключение "Поле НормализованныйАртикул для длинной строки: " + Результат.НормализованныйАртикул;
	КонецЕсли;
	
	ИсключениеПолучено = Ложь;
	Попытка
		ПроверкиFoodFactory.ПроверитьАртикул(42);
	Исключение
		ИсключениеПолучено = Истина;
	КонецПопытки;
	
	Если ИсключениеПолучено = Ложь Тогда
		ВызватьИсключение "Ожидалось исключение для числового артикула";
	КонецЕсли;
	
	
	Сообщить("Тест прошел проверку");
КонецПроцедуры

&НаСервереБезКонтекстаФункция НайтиНоменклатуруПоАртикулуНаСервере(Артикул)	Возврат Справочники.Номенклатура.НайтиПоАртикулу(Артикул);КонецФункции

&НаКлиенте
Процедура ТестПоискаПоАртикулу(Команда)
	НайденнаяНоменклатура = НайтиНоменклатуруПоАртикулуНаСервере(" flour-001 ");	Если НайденнаяНоменклатура.Пустая() Тогда		ВызватьИсключение "Номенклатура FLOUR-001 не найдена";	КонецЕсли;	Сообщить(НайденнаяНоменклатура);
	
	НеНайденнаяНоменклатура = НайтиНоменклатуруПоАртикулуНаСервере("UNKNOWN-001");
	Если НеНайденнаяНоменклатура.Пустая() = Ложь Тогда
		ВызватьИсключение "Для UNKNOWN-001 ожидалась пустая ссылка";
	КонецЕсли;
	Сообщить(НеНайденнаяНоменклатура);
	
	ИсключениеПолучено = Ложь;
	Попытка		НайтиНоменклатуруПоАртикулуНаСервере("");	Исключение
		ИсключениеПолучено = Истина;    	Сообщить(КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
	Если Не ИсключениеПолучено Тогда		ВызватьИсключение "Для пустого артикула ожидалось исключение";	КонецЕсли;
	Сообщить("Тест поиска по артикулу прошел");
КонецПроцедуры


