
&НаКлиенте
Процедура ПроверитьСтроки(Команда)
	Результат = УтилитыFoodFactory.НормализоватьАртикул(" flour-001 ");
	Сообщить(Результат);
	
	Результат = УтилитыFoodFactory.НормализоватьАртикул(Неопределено);
	Сообщить ("Неопределено -> [" + Результат + "]");
	
	Результат = УтилитыFoodFactory.НормализоватьАртикул("");
	Сообщить("Пустая строка -> [" + Результат + "]");  
	
	Результат = УтилитыFoodFactory.НормализоватьАртикул("мука-01");
	Сообщить(Результат); 
КонецПроцедуры

