&НаКлиенте
Процедура ПроверитьНормализациюМассива(Команда)
	ИсходныеАртикулы = Новый Массив;
	ИсходныеАртикулы.Добавить(" flour-001 ");
	ИсходныеАртикулы.Добавить("");
	ИсходныеАртикулы.Добавить(Неопределено);
	ИсходныеАртикулы.Добавить("milk-007");
	ИсходныеАртикулы.Добавить("FLOUR-001");
	Сообщить("Исходных до: " +  ИсходныеАртикулы.Количество());
	Результат = УтилитыFoodFactory.НормализоватьАртикулы(ИсходныеАртикулы);
	Сообщить("Исходных после: " + ИсходныеАртикулы.Количество());
	Сообщить("Результат: " + Результат.Количество());
	
	Для каждого Элемент Из Результат Цикл
		Сообщить(Элемент);
	КонецЦикла;
	
	Попытка
		УтилитыFoodFactory.НормализоватьАртикулы("2");
		Сообщить("ОШИБКА ТЕСТА: строка была принята как массив");
	Исключение
		Сообщить("Ожидаемая ошибка: " + ОписаниеОшибки());
	КонецПопытки;  
	
	Попытка
		ВременныйМассив = Новый Массив();
		ВременныйМассив.Добавить(42);
		УтилитыFoodFactory.НормализоватьАртикулы(ВременныйМассив);
		Сообщить("ОШИБКА ТЕСТА: массив был принят как массив чисел");                        
	Исключение
		Сообщить("Ожидаемая ошибка: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьАнализАртикулов(Команда)
	ИсходныеАртикулы = Новый Массив;
	ИсходныеАртикулы.Добавить(" flour-001 ");
	ИсходныеАртикулы.Добавить("milk-007");
	ИсходныеАртикулы.Добавить("FLOUR-001");
	ИсходныеАртикулы.Добавить("");
	ИсходныеАртикулы.Добавить("milk-007");
	ИсходныеАртикулы.Добавить("salt-001");
	ИсходныеАртикулы.Добавить("FLOUR-001");
	ИсходныеАртикулы.Добавить(" flour-001 ");
	
	РезультатАнализа = УтилитыFoodFactory.ПроанализироватьАртикулы(ИсходныеАртикулы);
	Сообщить("Нормализованных: " + РезультатАнализа.НормализованныеАртикулы.Количество());
	Сообщить("Дублей: " + РезультатАнализа.Дубли.Количество());
	
	Для Каждого Элемент Из РезультатАнализа.Дубли Цикл
		Сообщить(Элемент);
	КонецЦикла;
КонецПроцедуры


