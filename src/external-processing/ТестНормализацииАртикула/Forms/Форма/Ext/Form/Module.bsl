&НаКлиенте
Процедура ПроверитьКоличество(Команда)
	Результат = УтилитыFoodFactory.ПересчитатьКоличество(2, 10, 1);	Сообщить("2 упаковки по 10 штук -> " + Строка(Результат));  
	
	Результат = УтилитыFoodFactory.ПересчитатьКоличество(500, 0.001, 1);
	Сообщить("500 грам в киллограммы -> " + Строка(Результат));
	
	Результат = УтилитыFoodFactory.ПересчитатьКоличество(3, 1, 1);
	Сообщить("3 упаковки по 1 штуке -> " + Строка(Результат));
	
	Результат = УтилитыFoodFactory.ПересчитатьКоличество(0, 10, 1);
	Сообщить("0 упаковок по 10 штук -> " + Строка(Результат));
	
	Попытка		Результат = УтилитыFoodFactory.ПересчитатьКоличество("2", 10, 1);		Сообщить("ОШИБКА ТЕСТА: строковое количество принято, результат: " + Строка(Результат));	Исключение		Сообщить("Ожидаемая ошибка типа: " + ОписаниеОшибки());	КонецПопытки;     
	
	Попытка
		Результат = УтилитыFoodFactory.ПересчитатьКоличество(2, 0, 1);
		Сообщить("ОШИБКА ТЕСТА: ошибка исходного коэффициента: " + Строка(Результат));
	Исключение
		Сообщить("Ожидаемая ошибка типа: " + ОписаниеОшибки());
	КонецПопытки;  
	
	Попытка
		Результат = УтилитыFoodFactory.ПересчитатьКоличество(2, 10, 0);
		Сообщить("ОШИБКА ТЕСТА: ошибка целевого коэффициента: " + Строка(Результат));
	Исключение
		Сообщить("Ожидаемая ошибка типа: " + ОписаниеОшибки());
	КонецПопытки;
	
	Попытка
		Результат = УтилитыFoodFactory.ПересчитатьКоличество(-2, 10, 1);
		Сообщить("ОШИБКА ТЕСТА: ошибка отрицательного количества: " + Строка(Результат));
	Исключение
		Сообщить("Ожидаемая ошибка типа: " + ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

