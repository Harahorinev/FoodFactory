Функция ПроверитьАртикул(Артикул) Экспорт
	НормализованныйАртикул = УтилитыFoodFactory.НормализоватьАртикул(Артикул);
	РезультатПроверки = Новый Структура;
	
	Если НормализованныйАртикул = "" Тогда
		РезультатПроверки.Вставить("Корректен", Ложь);
		РезультатПроверки.Вставить("Сообщение", "Артикул не должен быть пустым");
		РезультатПроверки.Вставить("НормализованныйАртикул", НормализованныйАртикул);
		Возврат РезультатПроверки;
	КонецЕсли;
	
	Если СтрДлина(НормализованныйАртикул) > 30 Тогда
		РезультатПроверки.Вставить("Корректен", Ложь);
		РезультатПроверки.Вставить("Сообщение", "Артикул не должен быть длиннее 30 символов");
		РезультатПроверки.Вставить("НормализованныйАртикул", НормализованныйАртикул);
		Возврат РезультатПроверки;	КонецЕсли;
	
	РезультатПроверки.Вставить("Корректен", Истина);
	РезультатПроверки.Вставить("Сообщение", "");
	РезультатПроверки.Вставить("НормализованныйАртикул", НормализованныйАртикул);
	Возврат РезультатПроверки; 
	
	
КонецФункции