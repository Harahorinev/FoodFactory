	Функция НормализоватьАртикул(Артикул) Экспорт 
		Если Артикул = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Если ТипЗнч(Артикул) <> Тип("Строка") Тогда
			ВызватьИсключение "Артикул должен быть строкой";
		КонецЕсли;
		
		Результат = СокрЛП(Артикул);
		Результат = ВРег(Результат);
		
		Возврат Результат;	КонецФункции
	
	Функция ПересчитатьКоличество(Количество, ИсходныйКоэффициент, ЦелевойКоэффициент) Экспорт				Если ТипЗнч(Количество) <> Тип("Число") Тогда			ВызватьИсключение "Количество должно быть числом";		КонецЕсли;  
		Если ТипЗнч(ИсходныйКоэффициент) <> Тип("Число") Тогда
			ВызватьИсключение "ИсходныйКоэффициент должен быть числом";
		КонецЕсли;
		Если ТипЗнч(ЦелевойКоэффициент) <> Тип("Число") Тогда
			ВызватьИсключение "ЦелевойКоэффициент должен быть числом";
		КонецЕсли;		
		Если Количество < 0 Тогда
			ВызватьИсключение "Количество не может быть отрицательным";
		КонецЕсли;		
		Если ИсходныйКоэффициент <= 0 Тогда
			ВызватьИсключение "ИсходныйКоэффициент должен быть больше 0";
		КонецЕсли;		
		Если ЦелевойКоэффициент <= 0 Тогда
			ВызватьИсключение "ЦелевойКоэффициент должен быть больше 0";
		КонецЕсли;
		
		Возврат Количество * ИсходныйКоэффициент / ЦелевойКоэффициент;	КонецФункции                                    
	
	
